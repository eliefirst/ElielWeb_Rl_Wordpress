<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      layout="1column"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="page.main.title" remove="true"/>
        <referenceBlock name="breadcrumbs" remove="true"/>
        <referenceContainer name="wp.post.wrapper" remove="true"/>
        <referenceContainer name="wp.nav.terms" remove="true"/>

        <referenceContainer name="content">
            <container name="cms.container" htmlTag="div" htmlClass="homepage-wrapper">
                <block class="ElielWeb\RlWordpress\Block\Page"
                       name="cms.content"
                       template="ElielWeb_RlWordpress::page/homepage.phtml"/>
            </container>
        </referenceContainer>
    </body>
</page>
