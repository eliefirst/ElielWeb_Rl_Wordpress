<?php
/**
 * ElielWeb_RlWordpress — Text strate
 * Centered rich-text block with optional uptitle and title.
 *
 * @var \ElielWeb\RlWordpress\Block\Page\Strate $block
 * @var \Magento\Framework\Escaper $escaper
 */
declare(strict_types=1);

$strate  = $block->getStrate();
if (!$strate) return;

$title   = (string)($strate['strate_title']   ?? '');
$uptitle = (string)($strate['strate_uptitle'] ?? '');
$content = (string)($strate['strate_content'] ?? '');
?>

<div class="w-full px-4 md:px-8 py-12">
    <div class="flex justify-center">
        <div class="w-full md:w-2/3 text-center">
            <?php if ($uptitle !== ''): ?>
                <p class="text-xs uppercase tracking-widest text-neutral-500 mb-3">
                    <?= $block->escapeHtml($uptitle) ?>
                </p>
            <?php endif; ?>
            <?php if ($title !== ''): ?>
                <h2 class="text-3xl md:text-4xl font-semibold mb-6">
                    <?= $block->escapeHtml($title) ?>
                </h2>
            <?php endif; ?>
            <?php if ($content !== ''): ?>
                <div class="prose prose-neutral max-w-none mx-auto">
                    <?= /* @noEscape */ $content ?>
                </div>
            <?php endif; ?>
        </div>
    </div>
</div>
