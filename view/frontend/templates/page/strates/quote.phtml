<?php
/**
 * ElielWeb_RlWordpress — Quote strate
 * Italic quote with optional full-bleed background image.
 *
 * @var \ElielWeb\RlWordpress\Block\Page\Strate $block
 * @var \Magento\Framework\Escaper $escaper
 */
declare(strict_types=1);

$strate  = $block->getStrate();
if (!$strate) return;

$title   = (string)($strate['strate_title']   ?? '');
$content = (string)($strate['strate_content'] ?? '');
$image   = $strate['strate_image'] ?? null;

$imageUrl = $block->getWpImageUrl(is_array($image) ? $image : null);
?>

<?php if ($imageUrl !== ''): ?>
    <div class="relative overflow-hidden min-h-[50vh] flex items-center">
        <img src="<?= $block->escapeUrl($imageUrl) ?>"
             alt=""
             class="absolute inset-0 w-full h-full object-cover"
             loading="lazy"
             aria-hidden="true">
        <div class="absolute inset-0 bg-black/40" aria-hidden="true"></div>
        <div class="relative z-10 w-full px-4 md:px-8 py-16">
            <div class="flex justify-end">
                <div class="w-full md:w-1/2">
                    <?php if ($content !== ''): ?>
                        <blockquote class="text-white italic text-2xl md:text-3xl leading-relaxed">
                            <?= /* @noEscape */ $content ?>
                        </blockquote>
                    <?php endif; ?>
                </div>
            </div>
        </div>
    </div>
<?php else: ?>
    <div class="w-full px-4 md:px-8 py-12">
        <div class="flex justify-center">
            <div class="w-full md:w-2/3 text-center">
                <?php if ($title !== ''): ?>
                    <p class="text-sm uppercase tracking-widest text-neutral-500 mb-4">
                        <?= $block->escapeHtml($title) ?>
                    </p>
                <?php endif; ?>
                <?php if ($content !== ''): ?>
                    <blockquote class="italic text-2xl md:text-3xl leading-relaxed">
                        <?= /* @noEscape */ $content ?>
                    </blockquote>
                <?php endif; ?>
            </div>
        </div>
    </div>
<?php endif; ?>
