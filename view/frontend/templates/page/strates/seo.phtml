<?php
/**
 * ElielWeb_RlWordpress — SEO strate
 * Two-column SEO text blocks (for structured content at page bottom).
 *
 * @var \ElielWeb\RlWordpress\Block\Page\Strate $block
 * @var \Magento\Framework\Escaper $escaper
 */
declare(strict_types=1);

$strate    = $block->getStrate();
if (!$strate) return;

/** @var array<int, array<string, mixed>> $seoBlocks */
$seoBlocks = $strate['landing_seo'] ?? [];
if (empty($seoBlocks)) return;
?>

<div class="w-full px-4 md:px-8 py-12">
    <div class="flex flex-wrap justify-center gap-8">
        <?php foreach ($seoBlocks as $i => $seoBlock):
            $seoTitle   = (string)($seoBlock['landing_footer_seo_title']   ?? '');
            $seoUptitle = (string)($seoBlock['landing_footer_seo_uptitle'] ?? '');
            $seoContent = (string)($seoBlock['landing_footer_seo_content'] ?? '');

            if ($seoTitle === '' && $seoUptitle === '' && $seoContent === '') continue;

            $alignClass = $i === 0 ? 'text-right md:text-right text-left' : 'text-left';
        ?>
            <div class="w-full md:w-1/3 lg:w-1/4 <?= $alignClass ?>">
                <?php if ($seoUptitle !== ''): ?>
                    <p class="text-xs uppercase tracking-widest text-neutral-500 mb-2 opacity-60">
                        <?= $block->escapeHtml($seoUptitle) ?>
                    </p>
                <?php endif; ?>
                <?php if ($seoTitle !== ''): ?>
                    <h2 class="text-xl font-semibold mb-3">
                        <?= $block->escapeHtml($seoTitle) ?>
                    </h2>
                <?php endif; ?>
                <?php if ($seoContent !== ''): ?>
                    <div class="prose prose-neutral prose-sm max-w-none">
                        <?= /* @noEscape */ $seoContent ?>
                    </div>
                <?php endif; ?>
            </div>
        <?php endforeach; ?>
    </div>
</div>
