<?php
/**
 * ElielWeb_RlWordpress — CMS page template
 * Renders a WordPress CMS page with optional ACF "cms_page" flexible content
 * and a sidebar scroll-spy navigation (Alpine.js IntersectionObserver).
 *
 * @var \ElielWeb\RlWordpress\Block\Page $block
 * @var \Magento\Framework\Escaper $escaper
 */
declare(strict_types=1);

$post = $block->getPost();
if (!$post) return;

$strates = $block->getStrates('cms_page');
$sidebar = false;
/** @var \FishPig\WordPress\Model\Image|null $featuredImage */
$featuredImage = $post->getFeaturedImage();
?>

<article class="cms-page">

    <?php if ($featuredImage): ?>
        <header class="relative overflow-hidden h-64 md:h-96 bg-neutral-900">
            <img
                src="<?= $block->escapeUrl($featuredImage->getFullSizeImage()) ?>"
                alt="<?= $block->escapeHtmlAttr($post->getPostTitle()) ?>"
                class="absolute inset-0 w-full h-full object-cover"
                loading="eager"
                fetchpriority="high"
            >
            <div class="absolute inset-0 bg-black/40" aria-hidden="true"></div>
            <div class="relative z-10 flex items-center justify-center h-full">
                <h1 class="text-white text-4xl md:text-5xl font-semibold text-center px-4">
                    <?= $block->escapeHtml($post->getPostTitle()) ?>
                </h1>
            </div>
        </header>
    <?php endif; ?>

    <?php if ($strates): ?>
        <?php $sidebar = (bool)$post->getMetaValue('sidebar_navigation'); ?>
    <?php endif; ?>

    <div class="w-full px-4 md:px-8 py-12"
         <?php if ($sidebar): ?>x-data="cmsScrollSpy()"<?php endif; ?>
    >
        <div class="flex flex-wrap justify-center gap-8">

            <?php if ($sidebar && $strates): ?>
                <nav class="lg:w-1/4 w-full"
                     aria-label="<?= $block->escapeHtmlAttr(__('Page sections')) ?>">
                    <ul class="sticky top-24 space-y-2">
                        <?php foreach ($strates as $i => $strate):
                            $anchorTitle = (string)($strate['title'] ?? '');
                            $anchorId    = $anchorTitle !== ''
                                ? $block->escapeHtmlAttr($block->slugify($anchorTitle)) . '-' . ($i + 1)
                                : 'anchor-' . ($i + 1);
                        ?>
                            <li>
                                <a href="#<?= $anchorId ?>"
                                   class="block py-1 px-2 text-sm transition-colors hover:text-[#B4121C]"
                                   :class="activeSection === '<?= $anchorId ?>'
                                       ? 'text-[#B4121C] font-semibold'
                                       : 'text-neutral-600'"
                                   @click.prevent="scrollTo('<?= $anchorId ?>')">
                                    <?= $block->escapeHtml($anchorTitle) ?>
                                </a>
                            </li>
                        <?php endforeach; ?>
                    </ul>
                </nav>
            <?php endif; ?>

            <div class="<?= $sidebar ? 'lg:w-2/3' : 'lg:w-3/4' ?> w-full">

                <?php if (!$featuredImage): ?>
                    <h1 class="text-3xl md:text-4xl font-semibold mb-8">
                        <?= $block->escapeHtml($post->getPostTitle()) ?>
                    </h1>
                <?php endif; ?>

                <?php if ($strates): ?>
                    <?php foreach ($strates as $i => $strate):
                        $anchorTitle = (string)($strate['title'] ?? '');
                        $anchorId    = $anchorTitle !== ''
                            ? $block->escapeHtmlAttr($block->slugify($anchorTitle)) . '-' . ($i + 1)
                            : 'anchor-' . ($i + 1);
                    ?>
                        <section
                            id="<?= $anchorId ?>"
                            class="mb-12"
                            <?php if ($sidebar): ?>x-intersect:enter="activeSection = '<?= $anchorId ?>'"<?php endif; ?>
                        >
                            <?php if ($anchorTitle !== ''): ?>
                                <h2 class="text-2xl font-semibold mb-4">
                                    <?= $block->escapeHtml($anchorTitle) ?>
                                </h2>
                            <?php endif; ?>
                            <div class="prose max-w-none">
                                <?= /* @noEscape */ ($strate['content'] ?? '') ?>
                            </div>
                        </section>
                    <?php endforeach; ?>
                <?php else: ?>
                    <p class="text-neutral-500 italic">
                        <?= $block->escapeHtml(__('Add strates in WordPress to build this CMS page.')) ?>
                    </p>
                <?php endif; ?>

            </div>
        </div>
    </div>

</article>

<?php if ($sidebar): ?>
<script>
function cmsScrollSpy() {
    return {
        activeSection: '',
        scrollTo(id) {
            const el = document.getElementById(id);
            if (el) {
                el.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
        }
    };
}
</script>
<?php endif; ?>
