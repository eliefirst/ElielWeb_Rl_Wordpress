<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="1column" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="page.main.title" remove="true" />
        <referenceBlock name="breadcrumbs" remove="true" />
        <referenceContainer name="wp.post.wrapper" remove="true" />
        <referenceContainer name="wp.nav.terms" remove="true" />

        <referenceContainer name="content">
            <container name="cms.container" htmlTag="div" htmlClass="cms__wrapper">
                <block class="Rl\Wordpress\Block\Page" name="cms.content" template="Rl_Wordpress::page/homepage.phtml">
                    <block class="Magento\Framework\View\Element\Template" name="home_banner" template="Clrz_Homepage::home_banner.phtml" />
                    <block class="Magento\Framework\View\Element\Template" name="home_edito" template="Clrz_Homepage::home_edito.phtml" />
                    <block class="Magento\Framework\View\Element\Template" name="home_video" template="Clrz_Homepage::home_video.phtml" />
                    <block class="Rl\Homepage\Block\Products" name="home_products" template="Clrz_Homepage::home_products.phtml" />
                    <block class="Magento\Framework\View\Element\Template" name="home_configurator" template="Clrz_Homepage::home_configurator.phtml" />
                    <block class="Clrz\Community\Block\Footer\Instagram" name="homepage_instagram" />
                    <block class="Rl\Theme\Block\Homepage\About" name="footer_about"/>
                    <block class="Magento\Framework\View\Element\Template" name="footer_headline" template="Rl_Theme::page/html/footer/headline.phtml" />
                </block>
            </container>
        </referenceContainer>
    </body>
</page>
