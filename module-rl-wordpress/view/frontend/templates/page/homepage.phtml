<?php
/**
 * ElielWeb_RlWordpress — WordPress homepage dispatcher
 * Reads the ACF "home_strates" flexible content and renders child Strate blocks.
 *
 * @var \ElielWeb\RlWordpress\Block\Page $block
 * @var \Magento\Framework\Escaper $escaper
 */
declare(strict_types=1);

$strates = $block->getStrates('home_strates');
?>

<?php if ($strates): ?>
    <?php foreach ($strates as $strate):
        $template = (string)($strate['acf_fc_layout'] ?? '');
        if ($template === '') continue;
        $strateBlock = $block->getChildBlock($template);
        if (!$strateBlock) continue;
    ?>
        <?= $strateBlock->setStrate($strate)->toHtml() ?>
    <?php endforeach; ?>
<?php else: ?>
    <div class="flex justify-center items-center py-20 px-4">
        <p class="text-neutral-400 italic text-center">
            <?= $block->escapeHtml(__('No WordPress page is linked to this store in Magento configuration, or it was not found.')) ?>
        </p>
    </div>
<?php endif; ?>
