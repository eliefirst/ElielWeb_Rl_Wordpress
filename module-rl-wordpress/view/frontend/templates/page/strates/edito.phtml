<?php
/**
 * ElielWeb_RlWordpress — Edito strate
 * Two-column text + images layout with optional CTA.
 *
 * @var \ElielWeb\RlWordpress\Block\Page\Strate $block
 * @var \Magento\Framework\Escaper $escaper
 */
declare(strict_types=1);

$strate   = $block->getStrate();
if (!$strate) return;

$title    = (string)($strate['edito_title']    ?? '');
$uptitle  = (string)($strate['edito_uptitle']  ?? '');
$content  = (string)($strate['edito_content']  ?? '');
$cta      = $strate['edito_cta']               ?? null;
$reverse  = !empty($strate['edito_disposition']);

$image1   = $strate['edito_image_1']     ?? null;
$image2   = $strate['edito_image_2']     ?? null;
$image1Lk = $strate['edito_image_1_url'] ?? null;
$image2Lk = $strate['edito_image_2_url'] ?? null;

$img1Url = $block->getWpImageUrl(is_array($image1) ? $image1 : null);
$img2Url = $block->getWpImageUrl(is_array($image2) ? $image2 : null);
$img1Alt = $block->getWpImageAlt(is_array($image1) ? $image1 : null, $title);
$img2Alt = $block->getWpImageAlt(is_array($image2) ? $image2 : null, $title);

$link1 = is_array($image1Lk) ? (string)($image1Lk['url'] ?? '') : '';
$link2 = is_array($image2Lk) ? (string)($image2Lk['url'] ?? '') : '';

$ctaUrl   = is_array($cta) ? (string)($cta['url']    ?? '') : '';
$ctaLabel = is_array($cta) ? (string)($cta['title']  ?? '') : '';
$ctaBlank = is_array($cta) && ($cta['target'] ?? '') === '_blank';
?>

<?php if ($img1Url !== ''): ?>
<div class="w-full px-4 md:px-8 py-12">
    <div class="flex flex-wrap <?= $reverse ? 'flex-row-reverse' : '' ?> items-center gap-8">

        {{-- Text column --}}
        <div class="w-full md:w-5/12 flex flex-col gap-6">
            <?php if ($uptitle !== ''): ?>
                <span class="text-xs uppercase tracking-widest text-neutral-500">
                    <?= $block->escapeHtml($uptitle) ?>
                </span>
            <?php endif; ?>
            <?php if ($title !== ''): ?>
                <h2 class="text-2xl md:text-3xl font-semibold leading-snug">
                    <?= $block->escapeHtml($title) ?>
                </h2>
            <?php endif; ?>
            <?php if ($content !== ''): ?>
                <div class="prose prose-neutral max-w-none">
                    <?= /* @noEscape */ $content ?>
                </div>
            <?php endif; ?>
            <?php if ($ctaUrl !== ''): ?>
                <a href="<?= $block->escapeUrl($ctaUrl) ?>"
                   class="self-start inline-flex items-center gap-2 text-sm font-medium border-b border-current pb-0.5 hover:text-[#B4121C] transition-colors"
                   <?= $ctaBlank ? 'target="_blank" rel="noopener noreferrer"' : '' ?>>
                    <?= $block->escapeHtml($ctaLabel ?: $ctaUrl) ?>
                </a>
            <?php endif; ?>

            <?php if ($img2Url !== ''): ?>
                <div class="aspect-[3/2] overflow-hidden mt-4">
                    <?php if ($link2 !== ''): ?>
                        <a href="<?= $block->escapeUrl($link2) ?>" class="block w-full h-full">
                    <?php endif; ?>
                    <img src="<?= $block->escapeUrl($img2Url) ?>"
                         alt="<?= $block->escapeHtmlAttr($img2Alt) ?>"
                         class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
                         loading="lazy">
                    <?php if ($link2 !== ''): ?>
                        </a>
                    <?php endif; ?>
                </div>
            <?php endif; ?>
        </div>

        {{-- Main image column --}}
        <div class="w-full md:w-5/12 md:ml-auto aspect-[3/4] overflow-hidden">
            <?php if ($link1 !== ''): ?>
                <a href="<?= $block->escapeUrl($link1) ?>" class="block w-full h-full">
            <?php endif; ?>
            <img src="<?= $block->escapeUrl($img1Url) ?>"
                 alt="<?= $block->escapeHtmlAttr($img1Alt) ?>"
                 class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
                 loading="lazy">
            <?php if ($link1 !== ''): ?>
                </a>
            <?php endif; ?>
        </div>

    </div>
</div>
<?php endif; ?>
