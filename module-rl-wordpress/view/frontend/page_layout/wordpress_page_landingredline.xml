<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      layout="1column"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="page.main.title" remove="true"/>
        <referenceBlock name="breadcrumbs" remove="true"/>
        <referenceContainer name="wp.post.wrapper" remove="true"/>
        <referenceContainer name="wp.nav.terms" remove="true"/>

        <referenceContainer name="content">
            <container name="cms.container" htmlTag="div" htmlClass="landing-wrapper">
                <block class="ElielWeb\RlWordpress\Block\Page"
                       name="cms.content"
                       template="ElielWeb_RlWordpress::page/landing.phtml">
                    <block class="ElielWeb\RlWordpress\Block\Page\Strate"
                           name="hero"
                           template="ElielWeb_RlWordpress::page/strates/hero.phtml"/>
                    <block class="ElielWeb\RlWordpress\Block\Page\Strate"
                           name="edito"
                           template="ElielWeb_RlWordpress::page/strates/edito.phtml"/>
                    <block class="ElielWeb\RlWordpress\Block\Page\Strate"
                           name="image_video_full"
                           template="ElielWeb_RlWordpress::page/strates/image_video_full.phtml"/>
                    <block class="ElielWeb\RlWordpress\Block\Page\Strate"
                           name="push"
                           template="ElielWeb_RlWordpress::page/strates/push.phtml"/>
                    <block class="ElielWeb\RlWordpress\Block\Page\Strate"
                           name="quote"
                           template="ElielWeb_RlWordpress::page/strates/quote.phtml"/>
                    <block class="ElielWeb\RlWordpress\Block\Page\Strate"
                           name="text"
                           template="ElielWeb_RlWordpress::page/strates/text.phtml"/>
                    <block class="ElielWeb\RlWordpress\Block\Page\Strate"
                           name="seo"
                           template="ElielWeb_RlWordpress::page/strates/seo.phtml"/>
                </block>
            </container>
        </referenceContainer>
    </body>
</page>
